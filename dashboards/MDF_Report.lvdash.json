                "name": "main_query",
                "query": {
                  "datasetName": "ds_rpm_hist",
                  "fields": [
                    {
                      "name": "lower_bound",
                      "expression": "`lower_bound`"
                    },
                    {
                      "name": "duration_s",
                      "expression": "SUM(`duration_s`)"
                    }
