{
  "datasets": [
    {
      "name": "ds_container",
      "displayName": "container_metrics",
      "queryLines": [
        "SELECT * FROM mda_demo.default.container_metrics"
      ]
    },
    {
      "name": "ds_channel",
      "displayName": "channel_metrics",
      "queryLines": [
        "SELECT * FROM mda_demo.default.channel_metrics"
      ]
    },
    {
      "name": "ds_rpm_hist",
      "displayName": "rpm_histogram",
      "queryLines": [
        "SELECT lower_bound, MEASURE(total_duration_s) AS duration_s\n",
        "FROM mda_demo.default.mv_report_histogram\n",
        "WHERE histogram_name = 'rpm_histogram'\n",
        "GROUP BY lower_bound ORDER BY lower_bound"
      ]
    },
    {
      "name": "ds_speed_hist",
      "displayName": "speed_histogram",
      "queryLines": [
        "SELECT lower_bound, MEASURE(total_duration_s) AS duration_s\n",
        "FROM mda_demo.default.mv_report_histogram\n",
        "WHERE histogram_name = 'speed_histogram'\n",
        "GROUP BY lower_bound ORDER BY lower_bound"
      ]
    },
    {
      "name": "ds_heatmap",
      "displayName": "rpm_speed_heatmap",
      "queryLines": [
        "SELECT x_lower_bound, y_lower_bound, MEASURE(total_duration_s) AS duration_s\n",
        "FROM mda_demo.default.mv_report_heatmap\n",
        "GROUP BY x_lower_bound, y_lower_bound"
      ]
    },
    {
      "name": "ds_container_stats",
      "displayName": "container_stats",
      "queryLines": [
        "SELECT container_id, channel_name, aggregation_label, MEASURE(stat_value) AS statistic_value\n",
        "FROM mda_demo.default.mv_report_stats\n",
        "WHERE stats_name = 'container_stats'\n",
        "GROUP BY container_id, channel_name, aggregation_label"
      ]
    },
    {
      "name": "ds_milestones",
      "displayName": "values_at_distance_milestones",
      "queryLines": [
        "SELECT container_id, MEASURE(milestone_speed) AS vehicle_speed, MEASURE(milestone_rpm) AS engine_rpm\n",
        "FROM mda_demo.default.mv_report_stats\n",
        "WHERE stats_name = 'values_at_distance_milestones'\n",
        "GROUP BY container_id, event_instance_id"
      ]
    },
    {
      "name": "d0aed8cd",
      "displayName": "status",
      "config": {
        "version": "1.1",
        "source": "mda_demo.default.status",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "displayName": "Total Processed",
            "synonyms": [
              "run count",
              "number of runs"
            ],
            "name": "total_run_files",
            "expr": "SUM(filename)",
            "comment": "Total number of distinct runs processed"
          },
          {
            "displayName": "Failed",
            "synonyms": [
              "failure count",
              "unsuccessful runs"
            ],
            "name": "failed_runs",
            "expr": "COUNT(DISTINCT CASE WHEN status = 'failed' THEN filename END)",
            "comment": "Number of distinct runs with status marked as FAILURE"
          },
          {
            "displayName": "Successful",
            "synonyms": [
              "success count",
              "completed runs"
            ],
            "name": "successful_run_files",
            "expr": "COUNT(DISTINCT CASE WHEN status = 'succeeded' THEN filename END)",
            "comment": "Number of distinct runs with status marked as SUCCESS"
          },
          {
            "displayName": "Average Processing Time (seconds)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "synonyms": [
              "mean processing time",
              "average duration"
            ],
            "name": "avg_processing_time_seconds",
            "expr": "AVG(UNIX_TIMESTAMP(_processing_done_ts) - UNIX_TIMESTAMP(_load_ts))",
            "comment": "Average time in seconds between load and processing completion"
          }
        ]
      }
    }
  ],
