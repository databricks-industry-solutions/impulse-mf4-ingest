                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "showTitle": true,
                "title": "RPM histogram — duration per band (all drives)"
              },
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "lower_bound",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Engine RPM (bin lower bound)"
