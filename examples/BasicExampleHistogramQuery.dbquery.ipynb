       "command": "%sql WITH q AS (SELECT *\nFROM {{catalog}}.{{schema}}.channels c\nJOIN {{catalog}}.{{schema}}.channel_metrics cm ON c.channel_id = cm.channel_id AND c.container_id = cm.container_id\nWHERE\n  cm.channel_name = 'Engine RPM') ,min_max AS (SELECT `value`,(SELECT MAX(`value`) FROM q) `target_column_max`,(SELECT MIN(`value`) FROM q) `target_column_min` FROM q) ,histogram_meta AS (SELECT `value`,`target_column_min` `min_value`,IF(`target_column_max` = `target_column_min`,`target_column_max` + 1,`target_column_max`) `max_value`,(`target_column_max` - `target_column_min`) / 15 `step` FROM min_max) SELECT IF(ISNULL(`value`),NULL,LEAST(WIDTH_BUCKET(`value`,`min_value`,`max_value`,15),15)) `value_BIN`,FIRST(`min_value` + ((IF(ISNULL(`value`),NULL,LEAST(WIDTH_BUCKET(`value`,`min_value`,`max_value`,15),15)) - 1) * `step`)) `value_BIN_LOWER_BOUND`,FIRST(`step`) `value_BIN_STEP`,COUNT(`value`) `COUNT` FROM histogram_meta GROUP BY `value_BIN`",
